# Product ports
WEB_PORT=4173
API_PORT=8320
DB_PORT=55432

# Optional local Responses-compatible AI gateway.
# Keep credentials only in a local .env file; never commit them.
AI_ENABLED=false
AI_API_URL=http://host.docker.internal:8318/v1/responses
AI_MODEL=gpt-5.6-sol
AI_API_KEY=
AI_RATE_LIMIT_PER_MINUTE=12

# RailFit/KORAIL public-data key. Server-side only.
KORAIL_API_KEY=
